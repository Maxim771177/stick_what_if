{
  "id": "map-story",
  "name": "Map Story",
  "version": 1,
  "description": "Animated map stories: flat world maps that fly and zoom, countries and empires that grow, routes that draw on, countryballs with flags and faces, ticking year / population counters and a game-like HUD.",
  "characters": {"family": "faceobj", "eyes": "ball", "mouth": true},
  "fonts": {
    "title": {
      "family": "Baloo 2",
      "faces": [
        {"weight": "700", "src": "@fontsource/baloo-2/files/baloo-2-latin-700-normal.woff2"},
        {"weight": "800", "src": "@fontsource/baloo-2/files/baloo-2-latin-800-normal.woff2"}
      ]
    },
    "ui": {
      "family": "Nunito",
      "faces": [
        {"weight": "800", "src": "@fontsource/nunito/files/nunito-latin-800-normal.woff2"},
        {"weight": "900", "src": "@fontsource/nunito/files/nunito-latin-900-normal.woff2"}
      ]
    },
    "serif": {"family": "Caveat", "faces": [{"weight": "100 900", "src": "@fontsource/caveat/files/caveat-latin-700-normal.woff2"}]},
    "hud": {"family": "Press Start 2P", "faces": [{"weight": "100 900", "src": "@fontsource/press-start-2p/files/press-start-2p-latin-400-normal.woff2"}]}

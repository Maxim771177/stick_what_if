[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.18,
  "text": "Lunchline, Tuesday, 12 .05."
 },
 {
  "i": 1,
  "start": 2.96,
  "end": 6.2,
  "text": "Leon is holding a tray of tomato soup when he just stops."
 },
 {
  "i": 2,
  "start": 6.84,
  "end": 8.36,
  "text": "His eyes go glassy."
 },
 {
  "i": 3,
  "start": 8.7,
  "end": 10.08,
  "text": "His mouth hangs open."
 },
 {
  "i": 4,
  "start": 11.24,
  "end": 12.98,
  "text": "Owen waves a hand in front of his face."
 },
 {
  "i": 5,
  "start": 13.86,
  "end": 14.06,
  "text": "Dude?"
 },
 {
  "i": 6,
  "start": 14.6,
  "end": 14.82,
  "text": "Hello?"
 },
 {
  "i": 7,
  "start": 15.82,
  "end": 21.36,
  "text": "Three seconds later, Owen's tray slides toward the edge of the table, heading straight for his lap."
 },
 {
  "i": 8,
  "start": 22.14,
  "end": 23.62,
  "text": "Leon's hand is already there."
 },
 {
  "i": 9,
  "start": 24.16,
  "end": 25.7,
  "text": "The soup stays in the bowl."
 },
 {
  "i": 10,
  "start": 26.66,
  "end": 28.32,
  "text": "Owen stares at him."
 },
 {
  "i": 11,
  "start": 28.92,
  "end": 30.22,
  "text": "How did you do that?"
 },
 {
  "i": 12,
  "start": 31.16,
  "end": 34.82,
  "text": "Leon doesn't answer, because something stranger just happened."
 },
 {
  "i": 13,
  "start": 35.56,
  "end": 41.66,
  "text": "Ten seconds ago, he heard Owen say that exact sentence before Owen said it."
 },
 {
  "i": 14,
  "start": 42.48,
  "end": 46.48,
  "text": "So, what if you could see exactly ten seconds into the future?"
 },
 {
  "i": 15,
  "start": 47.2,
  "end": 54.0,
  "text": "And what happens when you see something you can't let happen and you only have ten seconds to stop it?"
 },
 {
  "i": 16,
  "start": 54.96,
  "end": 55.88,
  "text": "Here's how it works."
 },
 {
  "i": 17,
  "start": 56.74,
  "end": 57.06,
  "text": "Rule one."
 },
 {
  "i": 18,
  "start": 57.7,
  "end": 63.88,
  "text": "You see exactly ten seconds ahead, like a short movie in your head, and then you snap back."
 },
 {
  "i": 19,
  "start": 64.9,
  "end": 65.32,
  "text": "Rule two."
 },
 {
  "i": 20,
  "start": 65.94,
  "end": 67.24,
  "text": "Your body stays normal."
 },
 {
  "i": 21,
  "start": 67.76,
  "end": 70.48,
  "text": "You know what's coming, but you are not any faster."
 },
 {
  "i": 22,
  "start": 71.74,
  "end": 72.18,
  "text": "Rule three."
 },
 {
  "i": 23,
  "start": 73.18,
  "end": 74.3,
  "text": "The future isn't written."
 },
 {
  "i": 24,
  "start": 74.86,
  "end": 77.34,
  "text": "Change one thing and the whole movie updates."
 },
 {
  "i": 25,
  "start": 79.56,
  "end": 80.16,
  "text": "Rule four."
 },
 {
  "i": 26,
  "start": 80.78,
  "end": 82.78,
  "text": "The one Leon finds out in math class."
 },
 {
  "i": 27,
  "start": 83.88,
  "end": 85.74,
  "text": "Looking costs time."
 },
 {
  "i": 28,
  "start": 86.68,
  "end": 91.76,
  "text": "Every glimpse freezes him for about three seconds, and those seconds come out of the ten."
 },
 {
  "i": 29,
  "start": 92.9,
  "end": 95.32,
  "text": "Leon, says Miss Park, are you asleep?"
 },
 {
  "i": 30,
  "start": 96.22,
  "end": 96.92,
  "text": "No, ma 'am."
 },
 {
  "i": 31,
  "start": 97.4,
  "end": 98.7,
  "text": "Your marker is about to die."
 },
 {
  "i": 32,
  "start": 99.76,
  "end": 100.56,
  "text": "The marker dies."
 },
 {
  "i": 33,
  "start": 101.44,
  "end": 104.12,
  "text": "Miss Park looks at the marker for a long time."
 },
 {
  "i": 34,
  "start": 105.46,
  "end": 106.72,
  "text": "So Leon has a choice."
 },
 {
  "i": 35,
  "start": 107.36,
  "end": 112.36,
  "text": "Look a lot and live in a day's or look rarely and stay blind."
 },
 {
  "i": 36,
  "start": 113.38,
  "end": 116.38,
  "text": "And being ten years old, he picks a third option."
 },
 {
  "i": 37,
  "start": 117.16,
  "end": 118.6,
  "text": "He goes for the money."
 },
 {
  "i": 38,
  "start": 120.08,
  "end": 121.46,
  "text": "Saturday, hat trick sports."
 },
 {
  "i": 39,
  "start": 121.8,
  "end": 124.56,
  "text": "Assigned by the door says kids' penalty challenge."
 },
 {
  "i": 40,
  "start": 124.78,
  "end": 126.56,
  "text": "Stop four of five shots."
 },
 {
  "i": 41,
  "start": 126.86,
  "end": 128.56,
  "text": "Win $10 ,000."
 },
 {
  "i": 42,
  "start": 129.74,
  "end": 134.1,
  "text": "Leon pulls on gloves two sizes too big and walks into the goal."
 },
 {
  "i": 43,
  "start": 135.42,
  "end": 137.4,
  "text": "Here's the problem with penalty kicks."
 },
 {
  "i": 44,
  "start": 138.08,
  "end": 142.42,
  "text": "From 11 meters, a hard shot reaches the net in about half a second."
 },
 {
  "i": 45,
  "start": 143.08,
  "end": 146.1,
  "text": "A goalkeeper needs about that long just to react."
 },
 {
  "i": 46,
  "start": 146.74,
  "end": 149.1,
  "text": "So real keepers don't react."
 },
 {
  "i": 47,
  "start": 149.76,
  "end": 151.7,
  "text": "They guess and jump early."
 },
 {
  "i": 48,
  "start": 152.32,
  "end": 153.34,
  "text": "Leon doesn't have to guess."
 },
 {
  "i": 49,
  "start": 154.06,
  "end": 154.48,
  "text": "Shot one."
 },
 {
  "i": 50,
  "start": 154.96,
  "end": 158.76,
  "text": "He looks, freezes, and the referee mutters, is he okay?"
 },
 {
  "i": 51,
  "start": 159.6,
  "end": 162.98,
  "text": "Then Leon dives left a full second before the kick."
 },
 {
  "i": 52,
  "start": 163.78,
  "end": 164.04,
  "text": "Save."
 },
 {
  "i": 53,
  "start": 165.12,
  "end": 165.48,
  "text": "Shot two."
 },
 {
  "i": 54,
  "start": 166.0,
  "end": 166.12,
  "text": "Right."
 },
 {
  "i": 55,
  "start": 166.84,
  "end": 167.24,
  "text": "Save."
 },
 {
  "i": 56,
  "start": 168.2,
  "end": 168.62,
  "text": "Shot three."
 },
 {
  "i": 57,
  "start": 169.04,
  "end": 169.54,
  "text": "Left again."
 },
 {
  "i": 58,
  "start": 170.02,
  "end": 171.48,
  "text": "And the crowd starts chanting."
 },
 {
  "i": 59,
  "start": 172.24,
  "end": 173.16,
  "text": "Shot four."
 },
 {
  "i": 60,
  "start": 174.12,
  "end": 176.2,
  "text": "Leon sees the ball heading for the top corner."
 },
 {
  "i": 61,
  "start": 176.58,
  "end": 178.9,
  "text": "A rocket from a boy twice his size."
 },
 {
  "i": 62,
  "start": 179.46,
  "end": 181.38,
  "text": "He knows exactly where it's going."
 },
 {
  "i": 63,
  "start": 181.86,
  "end": 184.02,
  "text": "He dives with everything he has."
 },
 {
  "i": 64,
  "start": 184.5,
  "end": 186.98,
  "text": "His fingertips miss it by an inch."
 },
 {
  "i": 65,
  "start": 188.64,
  "end": 191.74,
  "text": "Knowing where a ball goes doesn't make your arms any longer."
 },
 {
  "i": 66,
  "start": 192.36,
  "end": 193.74,
  "text": "One miss is allowed."
 },
 {
  "i": 67,
  "start": 194.58,
  "end": 195.06,
  "text": "Shot five."
 },
 {
  "i": 68,
  "start": 195.62,
  "end": 195.84,
  "text": "Look."
 },
 {
  "i": 69,
  "start": 196.46,
  "end": 196.72,
  "text": "Freeze."
 },
 {
  "i": 70,
  "start": 197.48,
  "end": 197.62,
  "text": "Dive."
 },
 {
  "i": 71,
  "start": 198.34,
  "end": 198.62,
  "text": "Save."
 },
 {
  "i": 72,
  "start": 199.42,
  "end": 200.72,
  "text": "Four out of five."
 },
 {
  "i": 73,
  "start": 201.36,
  "end": 202.96,
  "text": "Ten thousand dollars."
 },
 {
  "i": 74,
  "start": 204.32,
  "end": 207.74,
  "text": "That night, Mom holds the envelope and asks one question."
 },
 {
  "i": 75,
  "start": 208.78,
  "end": 209.92,
  "text": "Where did you get this?"
 },
 {
  "i": 76,
  "start": 210.8,
  "end": 212.3,
  "text": "Luck, says Leon."
 },
 {
  "i": 77,
  "start": 213.28,
  "end": 215.1,
  "text": "She looks at him for a long time."
 },
 {
  "i": 78,
  "start": 216.04,
  "end": 220.32,
  "text": "Ten thousand dollars, and he can't tell anyone why."
 },
 {
  "i": 79,
  "start": 221.32,
  "end": 224.16,
  "text": "But money was never the thing Leon wanted most."
 },
 {
  "i": 80,
  "start": 225.38,
  "end": 230.12,
  "text": "Monday after school, Leon walks 20 steps behind Zoe, which is totally normal."
 },
 {
  "i": 81,
  "start": 230.34,
  "end": 232.88,
  "text": "She has headphones on and her bag over one shoulder."
 },
 {
  "i": 82,
  "start": 233.96,
  "end": 238.66,
  "text": "Leon has liked her since September, and he has never said a word about it."
 },
 {
  "i": 83,
  "start": 239.92,
  "end": 241.0,
  "text": "Then he looks ahead."
 },
 {
  "i": 84,
  "start": 241.7,
  "end": 242.18,
  "text": "A scooter."
 },
 {
  "i": 85,
  "start": 242.72,
  "end": 244.02,
  "text": "A boy in a gray hood."
 },
 {
  "i": 86,
  "start": 244.54,
  "end": 247.92,
  "text": "A hand grabbing the strap, and Zoe hitting the pavement."
 },
 {
  "i": 87,
  "start": 249.1,
  "end": 252.76,
  "text": "Leon freezes for three seconds, and seven are left."
 },
 {
  "i": 88,
  "start": 253.82,
  "end": 254.7,
  "text": "He sprints."
 },
 {
  "i": 89,
  "start": 254.98,
  "end": 255.7,
  "text": "Six seconds."
 },
 {
  "i": 90,
  "start": 256.12,
  "end": 256.42,
  "text": "Five."
 },
 {
  "i": 91,
  "start": 257.12,
  "end": 260.5,
  "text": "He grabs her sleeve and pulls her backward through an open garden gate."
 },
 {
  "i": 92,
  "start": 261.02,
  "end": 263.2,
  "text": "The scooter shoots past empty -handed."
 },
 {
  "i": 93,
  "start": 264.06,
  "end": 265.5,
  "text": "Zoe pulls out one headphone."
 },
 {
  "i": 94,
  "start": 266.24,
  "end": 267.12,
  "text": "What was that?"
 },
 {
  "i": 95,
  "start": 268.0,
  "end": 272.88,
  "text": "You looked like you were about to trip, says Leon, which is the worst lie of his life."
 },
 {
  "i": 96,
  "start": 274.14,
  "end": 274.86,
  "text": "She laughs anyway."
 },
 {
  "i": 97,
  "start": 275.64,
  "end": 280.54,
  "text": "Then she looks at the empty street, then at him, and she doesn't stop looking."
 },
 {
  "i": 98,
  "start": 281.62,
  "end": 286.08,
  "text": "From that day on, Leon and Zoe walk home together, every day."
 },
 {
  "i": 99,
  "start": 286.54,
  "end": 291.22,
  "text": "He is the happiest kid in the state, and he has no idea what's coming."
 },
 {
  "i": 100,
  "start": 292.46,
  "end": 294.4,
  "text": "Then, school gets easy."
 },
 {
  "i": 101,
  "start": 294.96,
  "end": 299.72,
  "text": "For the science presentation, Leon checks 10 seconds ahead on every slide."
 },
 {
  "i": 102,
  "start": 300.34,
  "end": 303.16,
  "text": "A joke that would make the class groan, he cuts."
 },
 {
  "i": 103,
  "start": 303.64,
  "end": 304.66,
  "text": "A fact that makes Ms."
 },
 {
  "i": 104,
  "start": 304.96,
  "end": 306.66,
  "text": "Park nod, he says twice."
 },
 {
  "i": 105,
  "start": 307.68,
  "end": 309.98,
  "text": "She gives him the highest score of the year."
 },
 {
  "i": 106,
  "start": 311.22,
  "end": 318.24,
  "text": "In gym class, he plays dodgeball, looks, steps left, ducks right, and nine balls miss him in a row."
 },
 {
  "i": 107,
  "start": 319.08,
  "end": 323.3,
  "text": "Coach Burke calls him the first kid in school history nobody can hit."
 },
 {
  "i": 108,
  "start": 324.12,
  "end": 327.68,
  "text": "By Friday, half the school calls him Lucky Leon."
 },
 {
  "i": 109,
  "start": 328.68,
  "end": 330.12,
  "text": "Nobody says smart."
 },
 {
  "i": 110,
  "start": 330.8,
  "end": 332.36,
  "text": "Everybody says lucky."
 },
 {
  "i": 111,
  "start": 333.14,
  "end": 336.52,
  "text": "And lucky people are not allowed to have a bad day."
 },
 {
  "i": 112,
  "start": 338.26,
  "end": 341.56,
  "text": "Then comes the big question, the Friday dance."
 },
 {
  "i": 113,
  "start": 342.64,
  "end": 345.82,
  "text": "Leon wants to ask Zoe, but first he looks."
 },
 {
  "i": 114,
  "start": 346.6,
  "end": 347.94,
  "text": "In the vision, he says,"
 },
 {
  "i": 115,
  "start": 348.74,
  "end": 349.66,
  "text": "do you want to go with me?"
 },
 {
  "i": 116,
  "start": 350.18,
  "end": 350.78,
  "text": "And she says,"
 },
 {
  "i": 117,
  "start": 351.66,
  "end": 353.22,
  "text": "sorry, I'm going with my cousin."
 },
 {
  "i": 118,
  "start": 354.64,
  "end": 355.54,
  "text": "Leon changes it."
 },
 {
  "i": 119,
  "start": 356.16,
  "end": 358.02,
  "text": "Look, freeze, three seconds."
 },
 {
  "i": 120,
  "start": 359.04,
  "end": 360.28,
  "text": "Would you like to go to the dance?"
 },
 {
  "i": 121,
  "start": 361.5,
  "end": 362.72,
  "text": "Sorry, I have a thing."
 },
 {
  "i": 122,
  "start": 363.96,
  "end": 364.66,
  "text": "Look, freeze."
 },
 {
  "i": 123,
  "start": 365.86,
  "end": 367.08,
  "text": "Zoe waves a hand at him."
 },
 {
  "i": 124,
  "start": 368.22,
  "end": 369.34,
  "text": "Leon, are you okay?"
 },
 {
  "i": 125,
  "start": 370.2,
  "end": 371.28,
  "text": "Third try."
 },
 {
  "i": 126,
  "start": 371.92,
  "end": 374.14,
  "text": "He phrases it a completely new way."
 },
 {
  "i": 127,
  "start": 375.0,
  "end": 377.98,
  "text": "And in the vision, Zoe smiles and says yes."
 },
 {
  "i": 128,
  "start": 378.92,
  "end": 381.4,
  "text": "So he says exactly those words."
 },
 {
  "i": 129,
  "start": 382.3,
  "end": 383.22,
  "text": "And Zoe says,"
 },
 {
  "i": 130,
  "start": 384.22,
  "end": 384.54,
  "text": "yes."
 },
 {
  "i": 131,
  "start": 386.12,
  "end": 387.88,
  "text": "But on the walk home, she stops."
 },
 {
  "i": 132,
  "start": 388.22,
  "end": 388.84,
  "text": "That was weird."
 },
 {
  "i": 133,
  "start": 389.46,
  "end": 391.6,
  "text": "You said the one sentence that works on me."
 },
 {
  "i": 134,
  "start": 392.02,
  "end": 393.58,
  "text": "Like you'd already heard my answer."
 },
 {
  "i": 135,
  "start": 394.62,
  "end": 396.28,
  "text": "Leon opens his mouth."
 },
 {
  "i": 136,
  "start": 397.06,
  "end": 397.88,
  "text": "Nothing comes out."
 },
 {
  "i": 137,
  "start": 398.72,
  "end": 400.62,
  "text": "Because she's right."
 },
 {
  "i": 138,
  "start": 401.48,
  "end": 404.08,
  "text": "He never heard what Zoe really wanted to say."
 },
 {
  "i": 139,
  "start": 404.66,
  "end": 407.26,
  "text": "He only heard what she'd say to a script."
 },
 {
  "i": 140,
  "start": 408.74,
  "end": 410.26,
  "text": "And here's the real part."
 },
 {
  "i": 141,
  "start": 410.88,
  "end": 417.54,
  "text": "In 1983, the neuroscientist Benjamin Libet and his team published a famous study in the journal Brain."
 },
 {
  "i": 142,
  "start": 418.26,
  "end": 425.04,
  "text": "They found that brain activity began about half a second before people said they had decided to move."
 },
 {
  "i": 143,
  "start": 426.58,
  "end": 428.72,
  "text": "Scientists still argue about what that means."
 },
 {
  "i": 144,
  "start": 429.48,
  "end": 432.06,
  "text": "But if brains decide before we notice,"
 },
 {
  "i": 145,
  "start": 433.12,
  "end": 435.48,
  "text": "what is Leon reading 10 seconds ahead?"
 },
 {
  "i": 146,
  "start": 436.54,
  "end": 437.18,
  "text": "Their choice?"
 },
 {
  "i": 147,
  "start": 437.9,
  "end": 439.18,
  "text": "Or his own script?"
 },
 {
  "i": 148,
  "start": 440.56,
  "end": 442.88,
  "text": "And that was the easy problem."
 },
 {
  "i": 149,
  "start": 443.58,
  "end": 445.94,
  "text": "The hard problem is time."
 },
 {
  "i": 150,
  "start": 447.08,
  "end": 450.14,
  "text": "Leon's day now has 40 glimpses."
 },
 {
  "i": 151,
  "start": 450.24,
  "end": 453.6,
  "text": "And every one is three seconds of staring at nothing."
 },
 {
  "i": 152,
  "start": 454.96,
  "end": 455.86,
  "text": "Teachers think he's sick."
 },
 {
  "i": 153,
  "start": 457.06,
  "end": 458.56,
  "text": "Friends think he's ignoring them."
 },
 {
  "i": 154,
  "start": 459.32,
  "end": 461.56,
  "text": "The school nurse takes his temperature twice."
 },
 {
  "i": 155,
  "start": 461.84,
  "end": 465.12,
  "text": "And the cafeteria he freezes in the middle of telling Owen a joke."
 },
 {
  "i": 156,
  "start": 465.58,
  "end": 468.54,
  "text": "And Owen says, that's the third time today."
 },
 {
  "i": 157,
  "start": 468.82,
  "end": 469.72,
  "text": "Just finish it."
 },
 {
  "i": 158,
  "start": 470.68,
  "end": 476.72,
  "text": "Worst of all, he stops hearing people because he's too busy listening to what they're about to say."
 },
 {
  "i": 159,
  "start": 477.48,
  "end": 480.38,
  "text": "The more he looks, the less he lives."
 },
 {
  "i": 160,
  "start": 481.6,
  "end": 483.7,
  "text": "A week later, it's the winter concert."
 },
 {
  "i": 161,
  "start": 484.52,
  "end": 486.7,
  "text": "Friday, the school gym, 7 o 'clock."
 },
 {
  "i": 162,
  "start": 487.38,
  "end": 491.88,
  "text": "Above the stage, a steel frame full of spotlights hangs from four cables."
 },
 {
  "i": 163,
  "start": 492.84,
  "end": 494.78,
  "text": "Owen stands right under it with his robot."
 },
 {
  "i": 164,
  "start": 495.34,
  "end": 497.82,
  "text": "And Zoe stands next to him, holding the plug."
 },
 {
  "i": 165,
  "start": 498.38,
  "end": 501.28,
  "text": "Leon sits in the third row with a bag of popcorn."
 },
 {
  "i": 166,
  "start": 501.78,
  "end": 503.78,
  "text": "Out of habit, he glances ahead."
 },
 {
  "i": 167,
  "start": 504.78,
  "end": 505.4,
  "text": "Three seconds."
 },
 {
  "i": 168,
  "start": 506.32,
  "end": 507.78,
  "text": "Then he sees it."
 },
 {
  "i": 169,
  "start": 508.26,
  "end": 509.62,
  "text": "One cable snaps."
 },
 {
  "i": 170,
  "start": 510.22,
  "end": 511.5,
  "text": "The frame swings."
 },
 {
  "i": 171,
  "start": 512.12,
  "end": 514.66,
  "text": "It falls straight onto Owen and Zoe."
 },
 {
  "i": 172,
  "start": 515.28,
  "end": 516.68,
  "text": "Leon snaps back."
 },
 {
  "i": 173,
  "start": 517.52,
  "end": 518.48,
  "text": "Seven seconds left."
 },
 {
  "i": 174,
  "start": 519.28,
  "end": 520.74,
  "text": "Now he has a choice."
 },
 {
  "i": 175,
  "start": 521.46,
  "end": 523.04,
  "text": "Run blind and hope."
 },
 {
  "i": 176,
  "start": 523.74,
  "end": 526.86,
  "text": "Or look again and lose three more seconds."
 },
 {
  "i": 177,
  "start": 528.1,
  "end": 529.46,
  "text": "Leon does the math out loud."
 },
 {
  "i": 178,
  "start": 530.54,
  "end": 530.66,
  "text": "Seven."
 },
 {
  "i": 179,
  "start": 531.24,
  "end": 533.12,
  "text": "If I run, I get there at three."
 },
 {
  "i": 180,
  "start": 533.98,
  "end": 534.64,
  "text": "He runs."
 },
 {
  "i": 181,
  "start": 535.34,
  "end": 536.2,
  "text": "Popcorn flies."
 },
 {
  "i": 182,
  "start": 537.14,
  "end": 538.26,
  "text": "Two seconds pass."
 },
 {
  "i": 183,
  "start": 538.82,
  "end": 539.42,
  "text": "Five left."
 },
 {
  "i": 184,
  "start": 539.78,
  "end": 540.48,
  "text": "He looks once."
 },
 {
  "i": 185,
  "start": 540.9,
  "end": 541.4,
  "text": "Only once."
 },
 {
  "i": 186,
  "start": 541.96,
  "end": 543.68,
  "text": "Because he has to know who to push."
 },
 {
  "i": 187,
  "start": 544.74,
  "end": 545.68,
  "text": "Three seconds gone."
 },
 {
  "i": 188,
  "start": 546.14,
  "end": 546.62,
  "text": "Two left."
 },
 {
  "i": 189,
  "start": 547.26,
  "end": 550.36,
  "text": "Shove Owen left, and Zoe is under the frame."
 },
 {
  "i": 190,
  "start": 550.96,
  "end": 552.88,
  "text": "Shove right, and Leon is."
 },
 {
  "i": 191,
  "start": 553.76,
  "end": 555.16,
  "text": "So he doesn't choose."
 },
 {
  "i": 192,
  "start": 555.9,
  "end": 558.86,
  "text": "He jumps onto the stage, yells, everybody move!"
 },
 {
  "i": 193,
  "start": 559.38,
  "end": 563.16,
  "text": "Throws his arms around both of them and drags them into the aisle."
 },
 {
  "i": 194,
  "start": 563.96,
  "end": 568.12,
  "text": "The frame hits an empty stage with a bang that rattles the windows."
 },
 {
  "i": 195,
  "start": 569.9,
  "end": 569.9,
  "text": "Silence."
 },
 {
  "i": 196,
  "start": 570.94,
  "end": 572.66,
  "text": "Then somebody laughs."
 },
 {
  "i": 197,
  "start": 573.52,
  "end": 574.56,
  "text": "Then somebody claps."
 },
 {
  "i": 198,
  "start": 575.26,
  "end": 579.06,
  "text": "And the whole gym stands up because they think it's part of the show."
 },
 {
  "i": 199,
  "start": 580.54,
  "end": 583.36,
  "text": "Afterward, Zoe holds his sleeve, still shaking."
 },
 {
  "i": 200,
  "start": 584.34,
  "end": 586.34,
  "text": "You froze right before it happened."
 },
 {
  "i": 201,
  "start": 586.88,
  "end": 588.02,
  "text": "You always do that."
 },
 {
  "i": 202,
  "start": 588.76,
  "end": 589.54,
  "text": "What do you see?"
 },
 {
  "i": 203,
  "start": 590.6,
  "end": 592.04,
  "text": "Leon thinks about lying."
 },
 {
  "i": 204,
  "start": 592.64,
  "end": 594.22,
  "text": "Instead, he tells her the truth."
 },
 {
  "i": 205,
  "start": 594.76,
  "end": 595.3,
  "text": "All of it."
 },
 {
  "i": 206,
  "start": 595.76,
  "end": 600.14,
  "text": "The 10 seconds, the 3 second price, the script, and the yes."
 },
 {
  "i": 207,
  "start": 601.46,
  "end": 603.2,
  "text": "Zoe is quiet for a long time."
 },
 {
  "i": 208,
  "start": 603.74,
  "end": 604.38,
  "text": "Then she says,"
 },
 {
  "i": 209,
  "start": 605.46,
  "end": 607.8,
  "text": "so ask me something else, without looking."
 },
 {
  "i": 210,
  "start": 609.08,
  "end": 609.92,
  "text": "Leon swallows."
 },
 {
  "i": 211,
  "start": 610.34,
  "end": 611.4,
  "text": "He doesn't look."
 },
 {
  "i": 212,
  "start": 611.74,
  "end": 619.52,
  "text": "He says something clumsy that makes no sense, and Zoe laughs and says something just as clumsy back, and neither of them knows what comes next."
 },
 {
  "i": 213,
  "start": 620.28,
  "end": 623.88,
  "text": "A plan is only worth the seconds you have left to use it."
 },
 {
  "i": 214,
  "start": 624.98,
  "end": 631.92,
  "text": "And these are the best 10 seconds of his life, because he didn't see a single one coming."
 },
 {
  "i": 215,
  "start": 633.89,
  "end": 634.77,
  "text": "Spring comes."
 },
 {
  "i": 216,
  "start": 635.55,
  "end": 637.97,
  "text": "Leon still looks, but he has learned to count."
 },
 {
  "i": 217,
  "start": 638.77,
  "end": 642.51,
  "text": "Then one night in bed, the vision runs a little longer than usual."
 },
 {
  "i": 218,
  "start": 643.17,
  "end": 643.81,
  "text": "He counts."
 },
 {
  "i": 219,
  "start": 644.63,
  "end": 644.93,
  "text": "8,"
 },
 {
  "i": 220,
  "start": 645.73,
  "end": 649.19,
  "text": "9, 10, 11."
 },
 {
  "i": 221,
  "start": 650.33,
  "end": 655.71,
  "text": "The vision is growing, and Leon has no idea what the extra second costs."
 },
 {
  "i": 222,
  "start": 656.97,
  "end": 658.57,
  "text": "So, what would you do?"
 },
 {
  "i": 223,
  "start": 659.23,
  "end": 662.37,
  "text": "Use it for money, for love, or to save a friend?"
 },
 {
  "i": 224,
  "start": 663.13,
  "end": 669.09,
  "text": "Tell us in the comments, and subscribe, because the 11th second is only getting started."
 }
]
[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.26,
  "text": "Tuesday, second period, room fourteen."
 },
 {
  "i": 1,
  "start": 2.26,
  "end": 3.02,
  "text": "Ms."
 },
 {
  "i": 2,
  "start": 3.02,
  "end": 5.6,
  "text": "Park walks down the rows handing back math tests."
 },
 {
  "i": 3,
  "start": 6.32,
  "end": 8.22,
  "text": "She stops at Caleb's desk and smiles."
 },
 {
  "i": 4,
  "start": 9.02,
  "end": 10.34,
  "text": "\"Perfect again, Caleb."
 },
 {
  "i": 5,
  "start": 11.04,
  "end": 13.94,
  "text": "Everyone, this is what talent looks like.\""
 },
 {
  "i": 6,
  "start": 14.74,
  "end": 19.02,
  "text": "Caleb holds up his paper, a giant red A-plus."
 },
 {
  "i": 7,
  "start": 19.02,
  "end": 22.82,
  "text": "Then she reaches Leon and drops his test on the desk without a word."
 },
 {
  "i": 8,
  "start": 23.56,
  "end": 25.54,
  "text": "A giant red F."
 },
 {
  "i": 9,
  "start": 26.6,
  "end": 28.9,
  "text": "Somebody in the back whispers, \"Ouch.\""
 },
 {
  "i": 10,
  "start": 30.0,
  "end": 31.14,
  "text": "Leon looks at Caleb."
 },
 {
  "i": 11,
  "start": 32.1,
  "end": 36.42,
  "text": "Floating above Caleb's head, glowing like a neon sign, is a number."
 },
 {
  "i": 12,
  "start": 37.6,
  "end": 38.24,
  "text": "Seventy."
 },
 {
  "i": 13,
  "start": 39.14,
  "end": 42.0,
  "text": "Leon turns to the window and sees his own reflection."
 },
 {
  "i": 14,
  "start": 43.06,
  "end": 44.3,
  "text": "One hundred and sixty."
 },
 {
  "i": 15,
  "start": 45.74,
  "end": 46.48,
  "text": "Owen leans over."
 },
 {
  "i": 16,
  "start": 47.36,
  "end": 48.82,
  "text": "\"Why are you staring at the window?\""
 },
 {
  "i": 17,
  "start": 49.92,
  "end": 51.42,
  "text": "\"Owen,\" says Leon,"
 },
 {
  "i": 18,
  "start": 52.52,
  "end": 53.22,
  "text": "\"I'm a genius.\""
 },
 {
  "i": 19,
  "start": 54.62,
  "end": 55.86,
  "text": "Owen glances at the F."
 },
 {
  "i": 20,
  "start": 56.68,
  "end": 57.56,
  "text": "\"Sure you are.\""
 },
 {
  "i": 21,
  "start": 58.4,
  "end": 61.24,
  "text": "So, what if you could see everyone's IQ?"
 },
 {
  "i": 22,
  "start": 61.78,
  "end": 66.06,
  "text": "And what happens when the numbers and the grades refuse to agree?"
 },
 {
  "i": 23,
  "start": 67.12,
  "end": 68.06,
  "text": "Here's how it works."
 },
 {
  "i": 24,
  "start": 68.94,
  "end": 69.84,
  "text": "Rule one."
 },
 {
  "i": 25,
  "start": 69.84,
  "end": 74.8,
  "text": "Every person has a glowing number above their head, and you're the only one who can see it."
 },
 {
  "i": 26,
  "start": 75.44,
  "end": 76.72,
  "text": "Rule two."
 },
 {
  "i": 27,
  "start": 76.72,
  "end": 85.98,
  "text": "It's a real IQ score on the standard scale, where one hundred is average and most people land between eighty-five and one hundred and fifteen."
 },
 {
  "i": 28,
  "start": 85.98,
  "end": 88.12,
  "text": "Rule three."
 },
 {
  "i": 29,
  "start": 88.12,
  "end": 95.6,
  "text": "The number is honest, but it only measures one thing, how fast a brain handles brand-new puzzles."
 },
 {
  "i": 30,
  "start": 96.4,
  "end": 97.8,
  "text": "It doesn't measure effort."
 },
 {
  "i": 31,
  "start": 98.38,
  "end": 99.62,
  "text": "It doesn't measure homework."
 },
 {
  "i": 32,
  "start": 100.46,
  "end": 104.88,
  "text": "And Leon, who has never read a manual in his life, skips that part."
 },
 {
  "i": 33,
  "start": 105.82,
  "end": 107.5,
  "text": "All he hears is this."
 },
 {
  "i": 34,
  "start": 108.4,
  "end": 115.912,
  "text": "Only about one person in thirty thousand scores a hundred and sixty."
 },
 {
  "i": 35,
  "start": 115.912,
  "end": 117.66,
  "text": "Finally, an explanation for why the teachers keep sighing at him."
 },
 {
  "i": 36,
  "start": 117.66,
  "end": 120.76,
  "text": "That morning goes like this."
 },
 {
  "i": 37,
  "start": 121.42,
  "end": 124.32,
  "text": "Mom is flipping pancakes, one hundred and four."
 },
 {
  "i": 38,
  "start": 125.1,
  "end": 129.14,
  "text": "Dad is asleep on the couch under a newspaper, one hundred and nine."
 },
 {
  "i": 39,
  "start": 129.98,
  "end": 136.98,
  "text": "The bus driver is a hundred and one, and he takes the first corner so fast that three kids scream."
 },
 {
  "i": 40,
  "start": 138.06,
  "end": 141.98,
  "text": "In the park, a man spends ten minutes fighting a paper map."
 },
 {
  "i": 41,
  "start": 142.58,
  "end": 145.44,
  "text": "One hundred and thirty-three."
 },
 {
  "i": 42,
  "start": 145.44,
  "end": 146.2,
  "text": "The map wins."
 },
 {
  "i": 43,
  "start": 146.72,
  "end": 153.62,
  "text": "A street magician pulls a coin from a kid's ear, one hundred and fifty-two, then drops his whole deck of cards."
 },
 {
  "i": 44,
  "start": 154.4,
  "end": 163.92,
  "text": "And the pizza guy on Maple Street, eighty-seven, is hanging his sign for the day, and he makes the best pizza Leon has ever eaten."
 },
 {
  "i": 45,
  "start": 164.96,
  "end": 166.8,
  "text": "So Leon starts keeping score."
 },
 {
  "i": 46,
  "start": 167.82,
  "end": 168.76,
  "text": "Smarter than the bus driver."
 },
 {
  "i": 47,
  "start": 169.3,
  "end": 170.14,
  "text": "Smarter than Dad."
 },
 {
  "i": 48,
  "start": 170.14,
  "end": 174.92,
  "text": "Smarter than the pizza guy, but definitely not smarter than the pizza."
 },
 {
  "i": 49,
  "start": 176.0,
  "end": 180.44,
  "text": "For the first time in his life, he feels like the smartest kid on the bus."
 },
 {
  "i": 50,
  "start": 181.54,
  "end": 186.4,
  "text": "Then the bus reaches school, and numbers turn out not to take tests."
 },
 {
  "i": 51,
  "start": 187.64,
  "end": 188.22,
  "text": "Problem one."
 },
 {
  "i": 52,
  "start": 188.82,
  "end": 191.2,
  "text": "The number turns Leon into a snob."
 },
 {
  "i": 53,
  "start": 192.04,
  "end": 193.82,
  "text": "At lunch, he scans the cafeteria."
 },
 {
  "i": 54,
  "start": 194.86,
  "end": 202.48,
  "text": "Nine hundred students, and the highest number in the whole building, besides his own, is one hundred and thirty-one."
 },
 {
  "i": 55,
  "start": 202.48,
  "end": 204.36,
  "text": "He is the smartest kid in school,"
 },
 {
  "i": 56,
  "start": 205.26,
  "end": 207.02,
  "text": "and he starts acting like it."
 },
 {
  "i": 57,
  "start": 207.84,
  "end": 210.52,
  "text": "Owen says, \"Hey, the test covers chapter seven.\""
 },
 {
  "i": 58,
  "start": 211.5,
  "end": 213.62,
  "text": "Leon checks the number above Owen's head."
 },
 {
  "i": 59,
  "start": 213.62,
  "end": 215.64,
  "text": "Ninety-seven."
 },
 {
  "i": 60,
  "start": 215.64,
  "end": 216.3,
  "text": "\"I'll be fine.\""
 },
 {
  "i": 61,
  "start": 216.62,
  "end": 222.7,
  "text": "A girl asks him for help with fractions, and he checks her number first, then explains it very slowly."
 },
 {
  "i": 62,
  "start": 223.8,
  "end": 224.22,
  "text": "Owen notices."
 },
 {
  "i": 63,
  "start": 224.9,
  "end": 225.72,
  "text": "Leon doesn't."
 },
 {
  "i": 64,
  "start": 226.28,
  "end": 228.08,
  "text": "Two weeks later, he fails again."
 },
 {
  "i": 65,
  "start": 228.62,
  "end": 232.42,
  "text": "His number is perfect, and his grades are a disaster."
 },
 {
  "i": 66,
  "start": 233.62,
  "end": 239.3,
  "text": "Meanwhile, every single week, Caleb gets an A-plus with seventy glowing over his head."
 },
 {
  "i": 67,
  "start": 240.32,
  "end": 241.24,
  "text": "That isn't possible."
 },
 {
  "i": 68,
  "start": 242.18,
  "end": 243.88,
  "text": "Unless Caleb is cheating."
 },
 {
  "i": 69,
  "start": 245.38,
  "end": 245.94,
  "text": "Problem two."
 },
 {
  "i": 70,
  "start": 246.86,
  "end": 248.3,
  "text": "Leon decides to catch him."
 },
 {
  "i": 71,
  "start": 249.32,
  "end": 253.82,
  "text": "Monday, six-forty in the morning, the school is empty, but the library light is already on."
 },
 {
  "i": 72,
  "start": 254.46,
  "end": 258.46,
  "text": "Caleb sits alone with a stack of index cards and a thick green notebook."
 },
 {
  "i": 73,
  "start": 259.24,
  "end": 261.08,
  "text": "Leon steps out from behind a bookshelf."
 },
 {
  "i": 74,
  "start": 261.88,
  "end": 262.04,
  "text": "\"Okay."
 },
 {
  "i": 75,
  "start": 262.58,
  "end": 263.34,
  "text": "How are you cheating?\""
 },
 {
  "i": 76,
  "start": 264.56,
  "end": 265.76,
  "text": "Caleb doesn't even look surprised."
 },
 {
  "i": 77,
  "start": 266.54,
  "end": 266.94,
  "text": "\"I'm not."
 },
 {
  "i": 78,
  "start": 267.46,
  "end": 268.72,
  "text": "And I know my number."
 },
 {
  "i": 79,
  "start": 269.1,
  "end": 270.42,
  "text": "They tested me in third grade."
 },
 {
  "i": 80,
  "start": 271.2,
  "end": 271.76,
  "text": "Seventy.\""
 },
 {
  "i": 81,
  "start": 272.88,
  "end": 273.76,
  "text": "Leon opens his mouth."
 },
 {
  "i": 82,
  "start": 274.54,
  "end": 275.54,
  "text": "Nothing comes out."
 },
 {
  "i": 83,
  "start": 276.5,
  "end": 280.4,
  "text": "\"About two kids in every hundred score that low or lower,\" says Caleb."
 },
 {
  "i": 84,
  "start": 280.4,
  "end": 282.36,
  "text": "\"Mom sat quiet for a minute."
 },
 {
  "i": 85,
  "start": 282.94,
  "end": 284.14,
  "text": "Then she bought me a notebook.\""
 },
 {
  "i": 86,
  "start": 285.16,
  "end": 286.0,
  "text": "He opens it."
 },
 {
  "i": 87,
  "start": 286.68,
  "end": 295.28,
  "text": "Every mistake he made all year is written inside, with the date, the wrong answer, the right one, and one more line that says why."
 },
 {
  "i": 88,
  "start": 296.3,
  "end": 297.56,
  "text": "\"Everybody thinks I'm gifted."
 },
 {
  "i": 89,
  "start": 297.98,
  "end": 298.54,
  "text": "I'm not."
 },
 {
  "i": 90,
  "start": 299.0,
  "end": 300.06,
  "text": "I just leave earlier.\""
 },
 {
  "i": 91,
  "start": 301.1,
  "end": 302.08,
  "text": "And here's the real part."
 },
 {
  "i": 92,
  "start": 302.62,
  "end": 309.56,
  "text": "In two thousand and five, the psychologists Angela Duckworth and Martin Seligman followed one hundred and forty eighth graders."
 },
 {
  "i": 93,
  "start": 309.56,
  "end": 315.28,
  "text": "Self-discipline predicted final grades more than twice as well as IQ did."
 },
 {
  "i": 94,
  "start": 316.56,
  "end": 318.58,
  "text": "Problem three, and it's the big one."
 },
 {
  "i": 95,
  "start": 319.16,
  "end": 323.92,
  "text": "A huge brain skips steps, and teachers grade steps."
 },
 {
  "i": 96,
  "start": 325.26,
  "end": 327.12,
  "text": "Leon starts copying Caleb."
 },
 {
  "i": 97,
  "start": 327.8,
  "end": 328.5,
  "text": "Index cards."
 },
 {
  "i": 98,
  "start": 328.5,
  "end": 330.02,
  "text": "Six-forty."
 },
 {
  "i": 99,
  "start": 330.02,
  "end": 332.74,
  "text": "A notebook of his own, with one page in it."
 },
 {
  "i": 100,
  "start": 333.28,
  "end": 338.96,
  "text": "On the next test, he gets every answer right, and the paper still comes back with a C."
 },
 {
  "i": 101,
  "start": 340.06,
  "end": 340.06,
  "text": "Ms."
 },
 {
  "i": 102,
  "start": 340.36,
  "end": 342.44,
  "text": "Park has circled two words in red."
 },
 {
  "i": 103,
  "start": 343.58,
  "end": 344.42,
  "text": "\"Show work.\""
 },
 {
  "i": 104,
  "start": 345.46,
  "end": 346.94,
  "text": "\"It's obvious,\" says Leon."
 },
 {
  "i": 105,
  "start": 347.96,
  "end": 350.28,
  "text": "\"Obvious is not a step,\" says Ms."
 },
 {
  "i": 106,
  "start": 350.6,
  "end": 350.62,
  "text": "Park."
 },
 {
  "i": 107,
  "start": 351.38,
  "end": 351.86,
  "text": "Half credit."
 },
 {
  "i": 108,
  "start": 353.1,
  "end": 359.68,
  "text": "Across the aisle, Caleb writes out every line, even the ones he could skip, then checks the whole page twice."
 },
 {
  "i": 109,
  "start": 360.24,
  "end": 364.2,
  "text": "Leon watches him, and for a second, he doesn't see the number at all."
 },
 {
  "i": 110,
  "start": 364.7,
  "end": 367.58,
  "text": "He sees a kid in the front row who got there early."
 },
 {
  "i": 111,
  "start": 368.56,
  "end": 370.58,
  "text": "Then comes the part nobody expects."
 },
 {
  "i": 112,
  "start": 371.44,
  "end": 382.12,
  "text": "In nineteen twenty-one, the psychologist Lewis Terman began following more than fifteen hundred children with enormous IQs, hoping to find the next generation of geniuses."
 },
 {
  "i": 113,
  "start": 382.9,
  "end": 385.78,
  "text": "Two kids were tested and didn't make the cut."
 },
 {
  "i": 114,
  "start": 386.28,
  "end": 389.38,
  "text": "Their names were William Shockley and Luis Alvarez."
 },
 {
  "i": 115,
  "start": 390.5,
  "end": 393.34,
  "text": "Both of them later won the Nobel Prize in Physics."
 },
 {
  "i": 116,
  "start": 394.58,
  "end": 397.26,
  "text": "Not one of the fifteen hundred did."
 },
 {
  "i": 117,
  "start": 398.48,
  "end": 403.38,
  "text": "Scientists still argue about what that proves, but it proves at least this."
 },
 {
  "i": 118,
  "start": 404.3,
  "end": 408.86,
  "text": "A number can predict a lot and still miss the thing that matters."
 },
 {
  "i": 119,
  "start": 409.86,
  "end": 413.64,
  "text": "Leon stares at his C, then at Caleb's notebook."
 },
 {
  "i": 120,
  "start": 414.66,
  "end": 415.48,
  "text": "And that's when Ms."
 },
 {
  "i": 121,
  "start": 415.78,
  "end": 416.92,
  "text": "Park makes an announcement."
 },
 {
  "i": 122,
  "start": 417.74,
  "end": 418.44,
  "text": "The science fair."
 },
 {
  "i": 123,
  "start": 419.22,
  "end": 426.78,
  "text": "Every team builds a Rube Goldberg machine, twenty steps of junk that must pop one balloon at the end, live, in front of the whole school."
 },
 {
  "i": 124,
  "start": 427.08,
  "end": 431.24,
  "text": "It counts for a third of the grade, and Leon is currently failing."
 },
 {
  "i": 125,
  "start": 432.48,
  "end": 432.76,
  "text": "Ms."
 },
 {
  "i": 126,
  "start": 433.06,
  "end": 433.94,
  "text": "Park reads the teams."
 },
 {
  "i": 127,
  "start": 434.62,
  "end": 435.58,
  "text": "\"Leon and Caleb."
 },
 {
  "i": 128,
  "start": 435.98,
  "end": 438.04,
  "text": "The highest number and the highest grade."
 },
 {
  "i": 129,
  "start": 438.04,
  "end": 439.5,
  "text": "What could go wrong?\""
 },
 {
  "i": 130,
  "start": 440.88,
  "end": 443.4,
  "text": "Leon sketches a beautiful machine in ten minutes."
 },
 {
  "i": 131,
  "start": 444.02,
  "end": 447.92,
  "text": "Dominoes, a toy train, a mousetrap, a bucket, a fan."
 },
 {
  "i": 132,
  "start": 448.9,
  "end": 450.0,
  "text": "\"Perfect,\" he says."
 },
 {
  "i": 133,
  "start": 450.92,
  "end": 451.56,
  "text": "They test it."
 },
 {
  "i": 134,
  "start": 452.04,
  "end": 453.78,
  "text": "It fails at step six."
 },
 {
  "i": 135,
  "start": 454.94,
  "end": 455.76,
  "text": "Caleb writes it down."
 },
 {
  "i": 136,
  "start": 456.46,
  "end": 457.36,
  "text": "They test it again."
 },
 {
  "i": 137,
  "start": 458.32,
  "end": 459.64,
  "text": "Step six again."
 },
 {
  "i": 138,
  "start": 460.7,
  "end": 462.4,
  "text": "Third time, step nine."
 },
 {
  "i": 139,
  "start": 463.38,
  "end": 465.62,
  "text": "\"This is a waste of time,\" says Leon."
 },
 {
  "i": 140,
  "start": 466.46,
  "end": 476.7,
  "text": "By Thursday, they have run it forty-one times, and it has failed forty-one times in thirty different ways, and Caleb has written down every one."
 },
 {
  "i": 141,
  "start": 477.62,
  "end": 479.76,
  "text": "\"You're not even fixing it,\" says Leon."
 },
 {
  "i": 142,
  "start": 480.74,
  "end": 483.02,
  "text": "\"I'm finding where it breaks,\" says Caleb."
 },
 {
  "i": 143,
  "start": 483.62,
  "end": 485.28,
  "text": "\"You can't fix what you haven't found.\""
 },
 {
  "i": 144,
  "start": 486.9,
  "end": 488.6,
  "text": "Run forty-two."
 },
 {
  "i": 145,
  "start": 488.6,
  "end": 490.22,
  "text": "Twenty steps, one pop."
 },
 {
  "i": 146,
  "start": 490.86,
  "end": 493.78,
  "text": "Owen cheers so loud that the janitor looks in."
 },
 {
  "i": 147,
  "start": 494.6,
  "end": 495.12,
  "text": "Leon grins."
 },
 {
  "i": 148,
  "start": 495.98,
  "end": 497.62,
  "text": "His design was never bad."
 },
 {
  "i": 149,
  "start": 498.3,
  "end": 499.84,
  "text": "It was just untested."
 },
 {
  "i": 150,
  "start": 500.8,
  "end": 504.34,
  "text": "The show is tomorrow, and nobody has tested the gym."
 },
 {
  "i": 151,
  "start": 504.78,
  "end": 508.42,
  "text": "Friday, the school gym, nine hundred students on folding chairs."
 },
 {
  "i": 152,
  "start": 509.24,
  "end": 512.56,
  "text": "The machine sits on a long table with a balloon at the far end."
 },
 {
  "i": 153,
  "start": 512.56,
  "end": 514.64,
  "text": "Owen holds the stopwatch."
 },
 {
  "i": 154,
  "start": 515.22,
  "end": 515.34,
  "text": "Ms."
 },
 {
  "i": 155,
  "start": 515.54,
  "end": 516.02,
  "text": "Park says,"
 },
 {
  "i": 156,
  "start": 516.84,
  "end": 516.88,
  "text": "\"Begin.\""
 },
 {
  "i": 157,
  "start": 516.88,
  "end": 518.5,
  "text": "Dominoes fall."
 },
 {
  "i": 158,
  "start": 518.92,
  "end": 519.84,
  "text": "The train rolls."
 },
 {
  "i": 159,
  "start": 520.32,
  "end": 525.56,
  "text": "The mousetrap snaps, the bucket tips, and eleven steps go perfectly."
 },
 {
  "i": 160,
  "start": 526.78,
  "end": 528.6,
  "text": "Then someone opens the gym door."
 },
 {
  "i": 161,
  "start": 529.4,
  "end": 535.3,
  "text": "A draft rolls across the table, and the paper sail at step twelve starts to turn the wrong way."
 },
 {
  "i": 162,
  "start": 536.44,
  "end": 540.48,
  "text": "Leon sees it in half a second, the way a hundred and sixty sees things."
 },
 {
  "i": 163,
  "start": 541.1,
  "end": 543.36,
  "text": "The marble is going to miss the ramp."
 },
 {
  "i": 164,
  "start": 544.04,
  "end": 545.48,
  "text": "He has maybe ten seconds."
 },
 {
  "i": 165,
  "start": 546.54,
  "end": 546.54,
  "text": "\"Caleb!"
 },
 {
  "i": 166,
  "start": 546.76,
  "end": 547.42,
  "text": "The notebook!"
 },
 {
  "i": 167,
  "start": 547.86,
  "end": 548.08,
  "text": "Draft!\""
 },
 {
  "i": 168,
  "start": 549.16,
  "end": 552.26,
  "text": "Caleb flips pages so fast he nearly rips one."
 },
 {
  "i": 169,
  "start": 552.92,
  "end": 553.6,
  "text": "\"Run nineteen."
 },
 {
  "i": 170,
  "start": 554.12,
  "end": 556.0,
  "text": "Door open, step twelve fails."
 },
 {
  "i": 171,
  "start": 556.46,
  "end": 558.34,
  "text": "Fix, a coin on the ramp.\""
 },
 {
  "i": 172,
  "start": 559.12,
  "end": 559.68,
  "text": "\"A coin?\""
 },
 {
  "i": 173,
  "start": 560.3,
  "end": 560.92,
  "text": "\"A coin!\""
 },
 {
  "i": 174,
  "start": 561.84,
  "end": 565.1,
  "text": "Owen digs in his pocket and throws a quarter across the table."
 },
 {
  "i": 175,
  "start": 565.1,
  "end": 571.74,
  "text": "Leon catches it, slaps it onto the ramp, and the marble rolls over it and into step thirteen."
 },
 {
  "i": 176,
  "start": 572.42,
  "end": 573.1,
  "text": "Fourteen."
 },
 {
  "i": 177,
  "start": 573.46,
  "end": 574.08,
  "text": "Fifteen."
 },
 {
  "i": 178,
  "start": 574.76,
  "end": 575.26,
  "text": "Seventeen."
 },
 {
  "i": 179,
  "start": 575.86,
  "end": 576.3,
  "text": "Nineteen."
 },
 {
  "i": 180,
  "start": 576.86,
  "end": 577.26,
  "text": "Twenty."
 },
 {
  "i": 181,
  "start": 578.16,
  "end": 582.42,
  "text": "The balloon explodes, and the whole gym erupts."
 },
 {
  "i": 182,
  "start": 582.58,
  "end": 586.26,
  "text": "Leon turns to Caleb, and Caleb is already writing in his notebook."
 },
 {
  "i": 183,
  "start": 587.02,
  "end": 587.78,
  "text": "\"What are you writing?\""
 },
 {
  "i": 184,
  "start": 588.58,
  "end": 589.84,
  "text": "\"Run forty-three."
 },
 {
  "i": 185,
  "start": 589.84,
  "end": 590.3,
  "text": "It worked.\""
 },
 {
  "i": 186,
  "start": 591.14,
  "end": 591.52,
  "text": "Ms."
 },
 {
  "i": 187,
  "start": 591.78,
  "end": 592.7,
  "text": "Park gives them an A."
 },
 {
  "i": 188,
  "start": 592.7,
  "end": 596.36,
  "text": "Not an A-plus, because Leon's sketch had no labels."
 },
 {
  "i": 189,
  "start": 596.94,
  "end": 600.76,
  "text": "He says it's obvious what the parts are, and then he hears himself."
 },
 {
  "i": 190,
  "start": 601.78,
  "end": 603.76,
  "text": "Afterward, he finds Caleb in the hallway."
 },
 {
  "i": 191,
  "start": 604.54,
  "end": 606.22,
  "text": "\"I'm sorry I called you a cheater.\""
 },
 {
  "i": 192,
  "start": 607.14,
  "end": 607.92,
  "text": "Caleb shrugs."
 },
 {
  "i": 193,
  "start": 608.26,
  "end": 609.0,
  "text": "\"You were wrong."
 },
 {
  "i": 194,
  "start": 609.28,
  "end": 610.32,
  "text": "But you checked."
 },
 {
  "i": 195,
  "start": 610.92,
  "end": 611.54,
  "text": "That's a start.\""
 },
 {
  "i": 196,
  "start": 612.7,
  "end": 616.74,
  "text": "Leon looks up at the seventy, then at the A in his hand."
 },
 {
  "i": 197,
  "start": 617.78,
  "end": 620.86,
  "text": "\"Seventy and an A-plus."
 },
 {
  "i": 198,
  "start": 620.86,
  "end": 623.16,
  "text": "A hundred and sixty and a C.\""
 },
 {
  "i": 199,
  "start": 624.14,
  "end": 625.32,
  "text": "He thinks about it."
 },
 {
  "i": 200,
  "start": 625.88,
  "end": 628.06,
  "text": "\"A number tells you where you start.\""
 },
 {
  "i": 201,
  "start": 628.68,
  "end": 632.16,
  "text": "\"And the notebook tells you where you end up,\" says Caleb."
 },
 {
  "i": 202,
  "start": 633.28,
  "end": 635.2,
  "text": "Then something strange happens."
 },
 {
  "i": 203,
  "start": 636.02,
  "end": 641.24,
  "text": "On Monday morning, Leon walks into class, glances up at Caleb, and freezes."
 },
 {
  "i": 204,
  "start": 641.24,
  "end": 642.74,
  "text": "Seventy-one."
 },
 {
  "i": 205,
  "start": 642.74,
  "end": 643.62,
  "text": "He checks the window."
 },
 {
  "i": 206,
  "start": 644.5,
  "end": 647.94,
  "text": "One hundred and fifty-nine."
 },
 {
  "i": 207,
  "start": 647.94,
  "end": 650.14,
  "text": "Numbers are not supposed to move."
 },
 {
  "i": 208,
  "start": 651.36,
  "end": 652.9,
  "text": "So, what would you do?"
 },
 {
  "i": 209,
  "start": 653.76,
  "end": 661.02,
  "text": "If a number hung over every head, whose would you check first, and whose would you be afraid to check?"
 },
 {
  "i": 210,
  "start": 662.02,
  "end": 667.8,
  "text": "Tell us in the comments, and subscribe, because these numbers have just started to move."
 }
]